rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // User profiles & personal settings
    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /{allChildren=**} {
        allow read, write: if isUser(uid);
      }
    }

    // Top-level Campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids) ||
        (request.auth.token.email != null && 'sharedWithEmails' in resource.data && request.auth.token.email in resource.data.sharedWithEmails)
      );

      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids) ||
        (request.auth.token.email != null && 'sharedWithEmails' in resource.data && request.auth.token.email in resource.data.sharedWithEmails)
      );

      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Leads subcollection in campaign
      match /leads/{leadId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid == request.auth.uid ||
          ('memberUids' in get(/databases/$(database)/documents/campaigns/$(campaignId)).data && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberUids) ||
          (request.auth.token.email != null && 'sharedWithEmails' in get(/databases/$(database)/documents/campaigns/$(campaignId)).data && request.auth.token.email in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.sharedWithEmails)
        );
      }

      // Settings in campaign
      match /settings/{docId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid == request.auth.uid ||
          ('memberUids' in get(/databases/$(database)/documents/campaigns/$(campaignId)).data && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberUids) ||
          (request.auth.token.email != null && 'sharedWithEmails' in get(/databases/$(database)/documents/campaigns/$(campaignId)).data && request.auth.token.email in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.sharedWithEmails)
        );
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
